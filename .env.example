# ==============================================================================
# CONFIGURAÇÕES PÚBLICAS DA LOJA (SEGURAS PARA FRONTEND E BACKEND - PREFIXO VITE_)
# ==============================================================================
# Nome exibido no cabeçalho e títulos da loja virtual
VITE_STORE_NAME="AgroMarconato"

# Descrição curta exibida na página inicial abaixo do título principal
VITE_STORE_DESCRIPTION="A Agro Marconato é uma loja de produtos agropecuários, artigos para pets e ponto de coleta e envio do Mercado Livre localizada em Irati, PR."

# Número de WhatsApp para suporte e combinação de frete fora de Irati (formato internacional com +55)
VITE_WHATSAPP_NUMBER="+55 42 98809-3611"

# URL opcional para substituir a imagem de destaque da página inicial sem alterar código
VITE_HERO_IMAGE_URL=""

# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR / VERCEL (VARIÁVEIS SECRETAS E PRIVADAS)
# ATENÇÃO: NUNCA coloque prefixo VITE_ nas variáveis abaixo!
# ==============================================================================
# URL do projeto Supabase (Painel Supabase -> Project Settings -> API -> Project URL)
SUPABASE_URL=""

# Chave pública anon do Supabase (Painel Supabase -> Project Settings -> API -> anon public)
SUPABASE_ANON_KEY=""

# Chave secreta service_role do Supabase (Painel Supabase -> Project Settings -> API -> service_role)
# CRÍTICO: Esta chave ignora RLS e deve ficar SOMENTE no servidor / Vercel (nunca no navegador).
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# PROVISIONAMENTO AUTOMÁTICO DO ADMINISTRADOR MÁXIMO (SUPER ADMIN)
# Preencha localmente no .env e nas Environment Variables da Vercel.
# O servidor provisiona automaticamente essa conta sem botões na tela.
# ==============================================================================
# Dados do primeiro administrador máximo (nunca coloque valores reais no GitHub)
INITIAL_SUPERADMIN_CPF=""
INITIAL_SUPERADMIN_EMAIL=""
INITIAL_SUPERADMIN_NAME=""
INITIAL_SUPERADMIN_PHONE=""
INITIAL_SUPERADMIN_PASSWORD=""

# ==============================================================================
# PAGAMENTO ONLINE (OPCIONAL - PREENCHER QUANDO INTEGRAR PROVEDOR REAL)
# ==============================================================================
# Chave secreta do gateway de pagamento (ex: Mercado Pago / Asaas / Stripe)
PAYMENT_PROVIDER_SECRET_KEY=""
